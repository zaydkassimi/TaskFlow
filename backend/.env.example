# TaskFlow backend environment variables (copy to .env and adjust).
# Never commit a real .env file.

# --- Database (matches docker-compose.yml defaults) ---
# Host port POSTGRES_PORT in docker-compose.yml is 15432 to avoid clashing with
# PostgreSQL already installed on the machine (often 5432).
DB_URL=jdbc:postgresql://localhost:15432/taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow

# --- JWT ---
# Use a long random value in any non-local environment, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-dev-only-secret-change-me-dev-only-secret
# Access token time-to-live in seconds (default 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token time-to-live in seconds (default 7 days)
JWT_REFRESH_TTL_SECONDS=604800

# --- CORS ---
# Only needed when the browser calls the API cross-origin (frontend uses a same-origin proxy by default).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Dev seed data ---
# Enables creation of the development-only sample accounts on startup.
SEED_DATA_ENABLED=true
