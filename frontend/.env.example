# TaskFlow frontend environment variables (copy to .env.local).
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Base path the browser uses to reach the API. Kept as "/api" so requests stay
# same-origin and flow through the Next.js proxy rewrite to the backend.
NEXT_PUBLIC_API_BASE_URL=/api

# Server-side target for the Next.js proxy rewrite (never exposed to the browser).
BACKEND_URL=http://localhost:8080
